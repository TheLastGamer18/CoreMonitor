#include <windows.h>

// Embed Application Manifest
1 RT_MANIFEST "app.manifest"

#if defined(BUILD_TARGET_CORE75) && !defined(BUILD_TARGET_COREM1)
#define RES_FILEDESC "Core Monitor - Core75"
#define RES_INTNAME  "CoreMonitor-Core75"
#define RES_ORIGNAME "CoreMonitor-Core75.exe"
#define RES_PRODNAME "Core Monitor - Core75"
#elif defined(BUILD_TARGET_COREM1) && !defined(BUILD_TARGET_CORE75)
#define RES_FILEDESC "Core Monitor - Core M1"
#define RES_INTNAME  "CoreMonitor-CoreM1"
#define RES_ORIGNAME "CoreMonitor-CoreM1.exe"
#define RES_PRODNAME "Core Monitor - Core M1"
#else
#define RES_FILEDESC "Core Monitor"
#define RES_INTNAME  "CoreMonitor"
#define RES_ORIGNAME "CoreMonitor.exe"
#define RES_PRODNAME "Core Monitor"
#endif

// Version Information
VS_VERSION_INFO VERSIONINFO
FILEVERSION     2,1,0,0
PRODUCTVERSION  2,1,0,0
FILEFLAGSMASK   VS_FFI_FILEFLAGSMASK
FILEFLAGS       0
FILEOS          VOS_NT_WINDOWS32
FILETYPE        VFT_APP
FILESUBTYPE     VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName",      "CoreMonitor"
            VALUE "FileDescription",  RES_FILEDESC
            VALUE "FileVersion",      "2.1.0"
            VALUE "InternalName",     RES_INTNAME
            VALUE "OriginalFilename", RES_ORIGNAME
            VALUE "ProductName",      RES_PRODNAME
            VALUE "ProductVersion",   "2.1.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
